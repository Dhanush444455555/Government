// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  phone             String?
  profilePicture    String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  education         String?
  workExperience    String?
  targetExam        String?
  preferredLanguage String   @default("english")
  isActive          Boolean  @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  enrollments       Enrollment[]
  progress          UserProgress[]
  testResults       TestResult[]
  bookmarks         Bookmark[]
  applications      JobApplication[]
  notifications     Notification[]
  chatSessions      ChatSession[]
  studySessions     StudySession[]
  
  @@map("users")
}

// Exam Categories
model ExamCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exams       Exam[]
  
  @@map("exam_categories")
}

// Exams
model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  categoryId      String
  examType        String // "government", "banking", "railway", "defense", etc.
  level           String // "beginner", "intermediate", "advanced"
  duration        Int // in minutes
  totalMarks      Int
  passingMarks    Int
  examDate        DateTime?
  lastDateToApply DateTime?
  officialWebsite String?
  eligibility     String?
  pattern         String?
  syllabus        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  category        ExamCategory @relation(fields: [categoryId], references: [id])
  enrollments     Enrollment[]
  studyMaterials  StudyMaterial[]
  mockTests       MockTest[]
  previousPapers  PreviousPaper[]
  
  @@map("exams")
}

// Study Materials
model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String   // rich text content
  type        String   // "notes", "video", "pdf", "article"
  subject     String?
  chapter     String?
  difficulty  String   // "easy", "medium", "hard"
  examId      String?
  materialUrl String?  // URL for external resources
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exam        Exam?    @relation(fields: [examId], references: [id])
  bookmarks   Bookmark[]
  progress    UserProgress[]
  
  @@map("study_materials")
}

// Mock Tests
model MockTest {
  id          String   @id @default(cuid())
  title       String
  description String?
  examId      String
  duration    Int // in minutes
  totalMarks  Int
  questions   Json // Array of questions with options
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exam        Exam @relation(fields: [examId], references: [id])
  testResults TestResult[]
  
  @@map("mock_tests")
}

// Previous Year Papers
model PreviousPaper {
  id          String   @id @default(cuid())
  title       String
  year        Int
  examId      String
  paperUrl    String?
  solutionUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exam        Exam @relation(fields: [examId], references: [id])
  
  @@map("previous_papers")
}

// User Enrollments
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  enrolledAt DateTime @default(now())
  status    String   @default("active") // "active", "completed", "paused"

  // Relations
  user      User @relation(fields: [userId], references: [id])
  exam      Exam @relation(fields: [examId], references: [id])
  
  @@unique([userId, examId])
  @@map("enrollments")
}

// User Progress Tracking
model UserProgress {
  id               String   @id @default(cuid())
  userId           String
  materialId       String?
  completionStatus String   @default("not_started") // "not_started", "in_progress", "completed"
  timeSpent        Int      @default(0) // in minutes
  score            Int?
  lastAccessedAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user             User @relation(fields: [userId], references: [id])
  material         StudyMaterial? @relation(fields: [materialId], references: [id])
  
  @@map("user_progress")
}

// Test Results
model TestResult {
  id          String   @id @default(cuid())
  userId      String
  mockTestId  String
  score       Int
  totalMarks  Int
  percentage  Float
  timeTaken   Int // in minutes
  answers     Json // User's answers
  feedback    String?
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // Relations
  user        User @relation(fields: [userId], references: [id])
  mockTest    MockTest @relation(fields: [mockTestId], references: [id])
  
  @@map("test_results")
}

// Bookmarks
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  // Relations
  user       User @relation(fields: [userId], references: [id])
  material   StudyMaterial @relation(fields: [materialId], references: [id])
  
  @@unique([userId, materialId])
  @@map("bookmarks")
}

// Job Listings
model Job {
  id              String   @id @default(cuid())
  title           String
  company         String?
  location        String?
  description     String?
  requirements    String?
  salary          String?
  jobType         String   // "government", "private", "contract"
  category        String?
  deadline        DateTime?
  applicationUrl  String?
  isActive        Boolean  @default(true)
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  applications    JobApplication[]
  
  @@map("jobs")
}

// Job Applications
model JobApplication {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  status      String   @default("applied") // "applied", "interview", "offer", "rejected"
  appliedAt   DateTime @default(now())
  resumeUrl   String?
  coverLetter String?
  notes       String?
  updatedAt   DateTime @updatedAt

  // Relations
  user        User @relation(fields: [userId], references: [id])
  job         Job @relation(fields: [jobId], references: [id])
  
  @@unique([userId, jobId])
  @@map("job_applications")
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // "exam", "job", "system", "reminder"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User @relation(fields: [userId], references: [id])
  
  @@map("notifications")
}

// AI Chat Sessions
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   @unique
  messages  Json     // Array of chat messages
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User @relation(fields: [userId], references: [id])
  
  @@map("chat_sessions")
}

// Study Sessions
model StudySession {
  id          String   @id @default(cuid())
  userId      String
  materialId  String?
  startTime   DateTime @default(now())
  endTime     DateTime?
  duration    Int?     // in minutes
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  user        User @relation(fields: [userId], references: [id])
  
  @@map("study_sessions")
}

// AI Mentorship Profiles
model MentorProfile {
  id          String   @id @default(cuid())
  name        String
  expertise   String   // "civil_services", "banking", "railway", etc.
  experience  String?
  bio         String?
  avatar      String?
  rating      Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("mentor_profiles")
}

// Current Affairs
model CurrentAffair {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // "national", "international", "sports", "economy", etc.
  date        DateTime
  source      String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("current_affairs")
}

// Interview Questions
model InterviewQuestion {
  id          String   @id @default(cuid())
  question    String
  answer      String?
  category    String   // "technical", "hr", "behavioral", "situational"
  difficulty  String   // "easy", "medium", "hard"
  jobType     String   // "government", "banking", "railway", etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("interview_questions")
}